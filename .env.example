# Copy to .env and adjust. Placeholders only — never real secrets.
# Web host (local, outside Compose): ConnectionStrings__ContentFlow
CONNECTION_STRING=Host=localhost;Database=contentflow;Username=contentflow;Password=contentflow
# Compose stack (docker compose up -d runs postgres -> migrator apply -> web)
ASPNETCORE_ENVIRONMENT=Development
WEB_PORT=5000
ADMINER_PORT=8080
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=contentflow
POSTGRES_DB=contentflow
# Optional services (docker compose --profile optional up -d)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
